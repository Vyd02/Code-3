rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/meta/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function myRole() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data.role : 'none';
    }
    function isCoOwner() { return signedIn() && myRole() == 'coowner'; }
    function isAdmin() { return isOwner() || (signedIn() && myRole() in ['admin', 'coowner']); }
    function isSupervisor() { return isAdmin() || (signedIn() && myRole() == 'supervisor'); }
    function isInspector() { return isAdmin() || (signedIn() && myRole() == 'inspector'); }
    function isMember() { return isSupervisor() || (signedIn() && myRole() in ['inspector', 'employee']); }

    // The first person to sign up becomes the owner (always admin)
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // People and roles: owner changes anyone; co-owners change everyone except the owner and co-owners
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'created'])
        && (request.resource.data.role == 'pending' || (request.resource.data.role == 'admin' && isOwner()));
      allow update: if isOwner()
        || (isCoOwner() && uid != get(ownerDoc()).data.uid && resource.data.role != 'coowner'
            && request.resource.data.role != 'coowner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
        || (request.auth.uid == uid && request.resource.data.role == resource.data.role
            && request.resource.data.keys().hasOnly(['name', 'role', 'created']));
      allow delete: if isOwner();
    }

    // Emails: only the person, the owner and co-owners can read them
    match /private/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner() || isCoOwner());
      allow create, update: if signedIn() && (request.auth.uid == uid || isOwner())
        && request.resource.data.keys().hasOnly(['email']);
      allow delete: if isOwner();
    }

    // Trucks: admins do everything, supervisors only move them
    match /trucks/{id} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSupervisor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['k', 'h', 'req', 'hold'])
            && !(request.resource.data.k in ['bubble', 'next']) && !(resource.data.k in ['bubble', 'next']))
        || (isInspector() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sig', 'req', 'h']));
    }

    // Station names, supervisors and crews
    match /plant/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Station comments
    match /comments/{id} {
      allow read: if isMember();
      allow create: if isSupervisor() && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || (isSupervisor() && resource.data.by == request.auth.uid);
    }
  }
}
